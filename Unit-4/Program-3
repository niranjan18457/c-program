Experiment 3: Array of Structures for Employee Details
Aim: To accept the details of N employees using an array of structures and display their information.
#include <stdio.h>

struct Employee
{
    int id;
    char name[50];
    float salary;
};

int main()
{
    struct Employee e[100];
    int n, i;

    printf("Enter number of employees: ");
    scanf("%d", &n);

    if (n < 1 || n > 100)
    {
        printf("Invalid number of employees.\n");
        return 1;
    }

    for (i = 0; i < n; i++)
    {
        printf("\nEnter details of employee %d\n", i + 1);

        printf("Enter employee ID: ");
        scanf("%d", &e[i].id);

        printf("Enter employee name: ");
        scanf(" %49[^\n]", e[i].name);

        printf("Enter salary: ");
        scanf("%f", &e[i].salary);
    }

    printf("\n--- Employee Details ---\n");

    for (i = 0; i < n; i++)
    {
        printf("\nEmployee ID: %d\n", e[i].id);
        printf("Name: %s\n", e[i].name);
        printf("Salary: %.2f\n", e[i].salary);
    }

    return 0;
}

