
Experiment 5: String Operations Using Built-in Functions
Aim: To perform string copy, reverse, length, comparison, and concatenation operations.

Note: C provides strcpy(), strlen(), strcmp(), and strcat() in the <string.h> library. It does not provide a standard strrev() function, so we reverse the string manually.
#include <stdio.h>
#include <string.h>

int main()
{
    char str1[100], str2[100];
    char copy[100];
    int i, length;

    printf("Enter first string: ");
    scanf(" %99[^\n]", str1);

    printf("Enter second string: ");
    scanf(" %99[^\n]", str2);

    /* 5.1 Copy one string to another */
    strcpy(copy, str1);
    printf("\nCopied string: %s\n", copy);

    /* 5.2 Reverse the string */
    length = strlen(str1);

    printf("Reversed string: ");
    for (i = length - 1; i >= 0; i--)
    {
        printf("%c", str1[i]);
    }
    printf("\n");

    /* 5.3 Find length of string */
    printf("Length of first string: %zu\n", strlen(str1));

    /* 5.4 Compare two strings */
    if (strcmp(str1, str2) == 0)
    {
        printf("Both strings are equal.\n");
    }
    else
    {
        printf("Both strings are not equal.\n");
    }

    /* 5.5 Concatenate two strings */
    if (strlen(str1) + strlen(str2) < sizeof(str1))
    {
        strcat(str1, str2);
        printf("Concatenated string: %s\n", str1);
    }
    else
    {
        printf("Strings are too long to concatenate.\n");
    }

    return 0;
}

Output:
Enter first string: Hello
Enter second string: World

Copied string: Hello
Reversed string: olleH
Length of first string: 5
Both strings are not equal.
Concatenated string: HelloWorld
